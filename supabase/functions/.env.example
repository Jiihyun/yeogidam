# save-instagram-reel Edge Function 로컬 환경변수 (예시).
# 실제 키를 채운 파일은 supabase/functions/.env 로 저장한다 (gitignore 처리됨 — 커밋되지 않음).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 `supabase functions serve` 가 자동 주입한다.

# Storage 공개 URL 생성 기준. 로컬은 http://127.0.0.1:54321, 배포는 Supabase project URL.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 장소 AI. 미설정 시 primary는 gemini, 요청별 timeout은 10000ms.
# 현재 배포는 OpenAI provider fallback을 사용하지 않으므로 아래 값은 비워 둔다.
# Gemini 내부 Primary/Fallback key 전환은 GEMINI_API_KEY_FALLBACKS로 설정한다.
PLACE_AI_PRIMARY_PROVIDER=gemini
PLACE_AI_FALLBACK_PROVIDER=
PLACE_AI_TIMEOUT_MS=10000

# Google Gemini. Primary는 cwlgusc 계정의 gen-lang-client-0666690473 프로젝트 key.
GEMINI_API_KEY=
# Fallback은 yeogidam 계정의 yeogidam 프로젝트 key. 여러 개면 쉼표로 구분한다.
# Gemini가 HTTP 429를 반환했을 때만 순서대로 시도한다.
# 같은 Google Cloud project의 key는 quota를 공유하므로 서로 다른 프로젝트여야 한다.
GEMINI_API_KEY_FALLBACKS=
# 장소 추출 모델 기본값은 gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
# 후보 판단 모델을 생략하면 GEMINI_MODEL과 같은 모델을 사용한다.
# GEMINI_MATCH_MODEL=gemini-3.5-flash-lite

# OpenAI 구현은 유지하지만 현재 배포 경로에는 연결하지 않는다.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# 후보 판단 모델을 생략하면 OPENAI_MODEL과 같은 모델을 사용한다.
# OPENAI_MATCH_MODEL=

# Kakao Local API 장소 검색 REST API 키
KAKAO_REST_API_KEY=

# Google Places API (장소 대표 사진 1순위)
GOOGLE_PLACES_API_KEY=

# Gemini runtime 전환/복구/장애 및 Google Cloud Monitoring RPD -> Discord 알림.
# Discord 채널 설정 > 연동 > 웹후크에서 만든 URL을 서버 secret으로만 보관한다.
DISCORD_GEMINI_ALERT_WEBHOOK_URL=
# Cloud Monitoring Webhook 채널에도 같은 Basic Auth 값을 입력한다.
# 영문/숫자로 된 충분히 긴 임의 값을 사용한다.
MONITORING_WEBHOOK_USERNAME=
MONITORING_WEBHOOK_PASSWORD=

# delete-account: Apple 재인증 authorization code를 교환·폐기할 때 사용.
# Apple client secret JWT는 서버에만 보관하며 보통 최대 6개월마다 교체한다.
APPLE_CLIENT_ID=com.yeogidamm.app
APPLE_CLIENT_SECRET=

# 로컬 e2e 테스트 시 동기 처리로 최종 상태를 응답에 담으려면 1 로 설정
# PIPELINE_SYNC=1

# 로컬 검증 전용: 장소 AI/Kakao 호출을 스텁으로 대체(키 없이 COMPLETED 검증). 프로덕션 금지.
# STUB_PROVIDERS=1
