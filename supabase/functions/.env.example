# save-instagram-reel Edge Function 로컬 환경변수 (예시).
# 실제 키를 채운 파일은 supabase/functions/.env 로 저장한다 (gitignore 처리됨 — 커밋되지 않음).
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY 는 `supabase functions serve` 가 자동 주입한다.

# Storage 공개 URL 생성 기준. 로컬은 http://127.0.0.1:54321, 배포는 Supabase project URL.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# 장소 분석은 2026-Yeogidam의 Gemini 단일 key/model 방식을 사용한다.
# 캡션은 Interactions + URL Context, 이미지·영상은 Files API + generateContent.
# 두 값 모두 필수이며 사용할 모델을 명시한다.
GEMINI_API_KEY=
GEMINI_MODEL=

# 기존 PLACE_AI_*, GEMINI_API_KEY_FALLBACKS, GEMINI_MATCH_MODEL,
# OPENAI_* 설정은 장소 분석 버전 11에서 사용하지 않는다.

# Kakao Local API 장소 검색 REST API 키
KAKAO_REST_API_KEY=

# Google Places API (장소 대표 사진 1순위)
GOOGLE_PLACES_API_KEY=

# gemini-quota-discord: Google Cloud Monitoring RPD -> Discord 알림.
# 새 장소 분석 경로는 기존 runtime 공급자 전환 알림을 보내지 않는다.
# Discord 채널 설정 > 연동 > 웹후크에서 만든 URL을 서버 secret으로만 보관한다.
DISCORD_GEMINI_ALERT_WEBHOOK_URL=
# Cloud Monitoring Webhook 채널에도 같은 Basic Auth 값을 입력한다.
# 영문/숫자로 된 충분히 긴 임의 값을 사용한다.
MONITORING_WEBHOOK_USERNAME=
MONITORING_WEBHOOK_PASSWORD=

# delete-account: Apple 재인증 authorization code를 교환·폐기할 때 사용.
# Apple client secret JWT는 서버에만 보관하며 보통 최대 6개월마다 교체한다.
APPLE_CLIENT_ID=com.yeogidamm.app
APPLE_CLIENT_SECRET=

# 앱 강제 업데이트 정책. 현재 버전이 최소 지원 버전보다 낮으면 업데이트를 요청한다.
APP_UPDATE_IOS_MINIMUM_SUPPORTED_VERSION=1.1.0
APP_UPDATE_IOS_STORE_URL=https://apps.apple.com/app/id6801408355
# Android 스토어 배포 후 값을 등록한다.
APP_UPDATE_ANDROID_MINIMUM_SUPPORTED_VERSION=
APP_UPDATE_ANDROID_STORE_URL=

# 로컬 e2e 테스트 시 동기 처리로 최종 상태를 응답에 담으려면 1 로 설정
# PIPELINE_SYNC=1

# 로컬 검증 전용: 장소 AI/Kakao 호출을 스텁으로 대체(키 없이 COMPLETED 검증). 프로덕션 금지.
# STUB_PROVIDERS=1
